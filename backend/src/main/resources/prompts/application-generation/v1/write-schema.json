{
  "type": "object",
  "additionalProperties": false,
  "required": ["contents", "claims", "warnings", "unsupportedRequirements"],
  "properties": {
    "contents": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "key", "order", "text"],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "RESUME_HEADLINE",
              "PROFESSIONAL_SUMMARY",
              "SKILL_SECTION",
              "EXPERIENCE_BULLET",
              "PROJECT_BULLET",
              "EDUCATION_SECTION",
              "COVER_LETTER",
              "RECRUITER_MESSAGE",
              "APPLICATION_ANSWER"
            ]
          },
          "key": { "type": "string", "minLength": 1, "maxLength": 150 },
          "order": { "type": "integer", "minimum": 0, "maximum": 50 },
          "text": { "type": "string", "minLength": 1, "maxLength": 2500 }
        }
      }
    },
    "claims": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contentKey",
          "claimText",
          "claimType",
          "factIds",
          "requirementIds",
          "jobFieldReference"
        ],
        "properties": {
          "contentKey": { "type": "string", "minLength": 1, "maxLength": 150 },
          "claimText": { "type": "string", "minLength": 1, "maxLength": 600 },
          "claimType": {
            "type": "string",
            "enum": ["CANDIDATE_FACT", "JOB_REFERENCE", "NON_FACTUAL"]
          },
          "factIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            }
          },
          "requirementIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            }
          },
          "jobFieldReference": { "type": ["string", "null"] }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "unsupportedRequirements": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
