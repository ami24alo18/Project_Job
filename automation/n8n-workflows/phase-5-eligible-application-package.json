    {
      "parameters": {
        "jsCode": "const event = $json.body ?? $json;\nconst evaluationId = String(event.evaluationId ?? '').trim();\nconst jobId = String(event.jobId ?? '').trim();\nconst uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;\nif (!uuid.test(evaluationId) || !uuid.test(jobId)) {\n  throw new Error('Event must contain valid evaluationId and jobId UUIDs');\n}\nreturn [{ json: { evaluationId, jobId } }];"
      },
      "id": "a98bd45a-d011-42eb-b321-a269ced65f77",
