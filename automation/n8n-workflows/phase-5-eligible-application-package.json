    {
      "parameters": {
        "jsCode": "const expected = $('Normalize Event').first().json;\nconst statusCode = Number($json.statusCode ?? 0);\nconst evaluation = $json.body && typeof $json.body === 'object' ? $json.body : {};\nlet reason = null;\nif (statusCode !== 200) reason = statusCode === 401 || statusCode === 403 ? 'AUTHORIZATION_FAILED' : `EVALUATION_LOOKUP_${statusCode || 'TRANSPORT_ERROR'}`;\nelse if (evaluation.id !== expected.evaluationId || evaluation.jobId !== expected.jobId) reason = 'EVENT_SOURCE_MISMATCH';\nelse if (evaluation.status !== 'SUCCEEDED') reason = 'EVALUATION_NOT_COMPLETED';\nelse if (evaluation.stale === true) reason = 'EVALUATION_STALE';\nelse if (!['STRONG_APPLY', 'APPLY'].includes(evaluation.recommendation)) reason = 'RECOMMENDATION_NOT_AUTOMATION_ELIGIBLE';\nreturn [{ json: { evaluationId: expected.evaluationId, jobId: expected.jobId, eligible: reason === null, reason } }];"
      },
